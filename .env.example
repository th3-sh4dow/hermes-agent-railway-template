# Dashboard port
PORT=8080

# Dashboard credentials (legacy names retained for migration compatibility)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Optional: use an independent session-signing secret after migration.
# Changing it logs dashboard users out but does not affect Hermes data.
# HERMES_DASHBOARD_BASIC_AUTH_SECRET=

# Supabase Storage Configuration (to bypass Railway 500MB volume limit)
# Get these from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-secret-key
# Alternative: SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# Optional: Supabase storage bucket name (default: hermes-data)
# SUPABASE_BUCKET=hermes-data

# Optional: File size threshold in MB to trigger upload (default: 10)
# STORAGE_THRESHOLD_MB=10

# Optional: Total directory size threshold in MB to trigger cleanup (default: 400)
# STORAGE_TOTAL_THRESHOLD_MB=400

